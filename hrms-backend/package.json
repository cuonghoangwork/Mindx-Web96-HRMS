{
  "name": "hrms-backend",
  "version": "1.0.0",
  "description": "MindX Web96 HRMS Capstone - Backend (Express + MongoDB/Mongoose, MVC)",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev:env": "cross-env NODE_ENV=dev nodemon index.js",
    "uat:env": "cross-env NODE_ENV=uat nodemon index.js",
    "production:env": "cross-env NODE_ENV=production node index.js",
    "start": "node index.js",
    "seed:env": "cross-env NODE_ENV=dev node seed.js",
    "migrate:leave-types": "cross-env NODE_ENV=dev node scripts/migrateLeaveTypes.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "rolldown": "^1.2.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  },
  "vitest": {
    "environment": "node"
  },
  "mongoms": {
    "version": "7.0.14",
    "downloadDir": "/tmp/mongodb-binaries"
  }
}
