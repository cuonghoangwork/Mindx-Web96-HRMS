{
  "info": {
    "name": "HRMS — Attendance Overtime (M2)",
    "description": "Every overtime endpoint, in the order the demo walks through them.\n\nSetup:\n1. Set the `baseUrl` variable (default http://localhost:8080/api/v1).\n2. Run \"Login (admin)\" — it writes `token` for every other request.\n3. Set `employeeId` from GET /employees.\n\nThe cutoff requests send an `X-App-Now` header to move the server clock. That header is only honoured when DEMO_MODE=true in the backend environment (utils/appNow.js) — it is inert in production, which is the point. Leave DEMO_MODE unset on Render.\n\nThis collection doubles as the demo backup: if the UI breaks, every rule below can still be shown from here.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "employeeId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "otDate", "value": "2026-07-02", "description": "A future working day." },
    { "key": "otSaturday", "value": "2026-07-04", "description": "A future Saturday — rest-day rates." }
  ],
  "item": [
    {
      "name": "Login (admin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('token', body.data.access_token);",
              "pm.test('logged in', () => pm.expect(body.data.access_token).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@hrms.com\",\n  \"password\": \"admin123\"\n}"
        }
      }
    },
    {
      "name": "Apply — weekday 18:00-22:00 (4h, 150%)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.success) pm.collectionVariables.set('requestId', body.data.id);",
              "pm.test('created as pending', () => pm.expect(body.data.status).to.eql('pending'));",
              "pm.test('4 hours, normal day', () => {",
              "  pm.expect(body.data.plannedMinutes).to.eql(240);",
              "  pm.expect(body.data.dayType).to.eql('normal');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/overtime-requests", "host": ["{{baseUrl}}"], "path": ["overtime-requests"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"{{otDate}}\",\n  \"plannedStart\": \"18:00\",\n  \"plannedEnd\": \"22:00\",\n  \"reason\": \"release deploy\"\n}"
        }
      }
    },
    {
      "name": "Apply — Saturday 12:00-24:00 (12h, 200% + 270% night)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/overtime-requests", "host": ["{{baseUrl}}"], "path": ["overtime-requests"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"{{otSaturday}}\",\n  \"plannedStart\": \"12:00\",\n  \"plannedEnd\": \"24:00\",\n  \"reason\": \"migration window\"\n}"
        },
        "description": "\"24:00\" is the end-of-day sentinel (parseHHMMEnd). Spans may not cross midnight, so this is how a shift that runs to the end of the day is expressed. Expect dayType: restDay and 720 planned minutes."
      }
    },
    {
      "name": "Apply — REJECTED: past the 13:00 cutoff",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 OT_APPLICATION_PAST_CUTOFF', () => {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().code).to.eql('OT_APPLICATION_PAST_CUTOFF');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "X-App-Now", "value": "2026-07-02T06:01:00.000Z", "description": "13:01 in Asia/Ho_Chi_Minh on the overtime date. Requires DEMO_MODE=true." }
        ],
        "url": { "raw": "{{baseUrl}}/overtime-requests", "host": ["{{baseUrl}}"], "path": ["overtime-requests"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"{{otDate}}\",\n  \"plannedStart\": \"18:00\",\n  \"plannedEnd\": \"22:00\"\n}"
        },
        "description": "Run this as an EMPLOYEE token to see the rejection. As HR/ADMIN the cutoff is skipped and this succeeds — that contrast is demo step 2."
      }
    },
    {
      "name": "Apply — REJECTED: over the 4h daily cap",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/overtime-requests", "host": ["{{baseUrl}}"], "path": ["overtime-requests"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"{{otDate}}\",\n  \"plannedStart\": \"17:00\",\n  \"plannedEnd\": \"22:00\"\n}"
        },
        "description": "5h on a working day. Expect 409 OT_EXCEEDS_DAILY_CAP with params.cap = 4."
      }
    },
    {
      "name": "Apply — REJECTED: crosses midnight",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/overtime-requests", "host": ["{{baseUrl}}"], "path": ["overtime-requests"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"{{otSaturday}}\",\n  \"plannedStart\": \"22:00\",\n  \"plannedEnd\": \"02:00\"\n}"
        },
        "description": "Expect 400 OT_CROSSES_MIDNIGHT. Without the explicit guard this would silently price as 0 hours, because hoursBetween clamps a negative span to 0."
      }
    },
    {
      "name": "Assign (HR/Manager) — bulk",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/overtime-requests/assign", "host": ["{{baseUrl}}"], "path": ["overtime-requests", "assign"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"date\": \"{{otDate}}\",\n  \"plannedStart\": \"18:00\",\n  \"plannedEnd\": \"22:00\",\n  \"reason\": \"scheduled release\",\n  \"employeeIds\": [\"{{employeeId}}\"]\n}"
        },
        "description": "Partial success by design: the response carries `created` and `skipped`, so one employee being over their cap does not discard the rest. Assignment skips the 13:00 cutoff."
      }
    },
    {
      "name": "List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/overtime-requests?status=pending",
          "host": ["{{baseUrl}}"],
          "path": ["overtime-requests"],
          "query": [{ "key": "status", "value": "pending" }]
        },
        "description": "Role-scoped by the shared review-queue handler: EMPLOYEE sees only their own, MANAGER their own department, HR/ADMIN everything."
      }
    },
    {
      "name": "Balance (caps meter)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/overtime-requests/balance?year=2026&month=7",
          "host": ["{{baseUrl}}"],
          "path": ["overtime-requests", "balance"],
          "query": [
            { "key": "year", "value": "2026" },
            { "key": "month", "value": "7" }
          ]
        },
        "description": "Returns monthUsed/monthCap/monthRemaining and the annual equivalents. Pending requests count toward the total, so an employee cannot queue several individually-legal requests that are collectively over the ceiling."
      }
    },
    {
      "name": "Review — approve",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/overtime-requests/{{requestId}}/review",
          "host": ["{{baseUrl}}"],
          "path": ["overtime-requests", "{{requestId}}", "review"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"approved\",\n  \"reviewNote\": \"Approved for the release.\"\n}"
        },
        "description": "MANAGER additionally needs the approveOvertimeRequests capability enabled (Settings > permissions matrix); HR/ADMIN always pass."
      }
    },
    {
      "name": "Cancel (withdraw own pending request)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/overtime-requests/{{requestId}}",
          "host": ["{{baseUrl}}"],
          "path": ["overtime-requests", "{{requestId}}"]
        },
        "description": "Owner only, pending only, before the cutoff. Deletes rather than marking rejected — a withdrawal is not a decision someone made about the request, and deleting frees the date for a corrected resubmission."
      }
    }
  ]
}
