# Copy this file to .env.dev (and .env.uat / .env.production as needed).
# Never commit real .env.* files - only .env.example.

NODE_ENV=dev
PORT=8080

# MongoDB connection string (local example shown; swap for an Atlas URI in uat/production)
CONNECT_STRING=mongodb://localhost:27017/hrms

# Two SEPARATE secrets for Access Token / Refresh Token, per the course's lesson9 pattern.
# Generate strong random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AT_SECRETKEY=replace_with_a_long_random_string
RT_SECRETKEY=replace_with_a_different_long_random_string

AT_EXPIRES_IN=20m
RT_EXPIRES_IN=4w

# Restrict this to the actual frontend origin in uat/production
CORS_ORIGIN=http://localhost:3000

# Cloudinary (avatar / image uploads) - https://cloudinary.com, free tier is fine for a demo.
# Image upload endpoints respond with a clear error if these are left unset, rather than crashing.
CLOUD_NAME=replace_with_your_cloudinary_cloud_name
API_KEY=replace_with_your_cloudinary_api_key
API_SECRET=replace_with_your_cloudinary_api_secret

# Public self-registration. Keep "false" for an internal deployment - accounts are
# then created only through the Add Employee flow. Anything other than "true" is closed.
ALLOW_PUBLIC_REGISTRATION=false

# Domain used to derive a login email from the Employee ID when HR leaves the
# email field blank, e.g. EMP009 -> emp009@hrms.com
ACCOUNT_EMAIL_DOMAIN=hrms.com

# Task scheduler (node-cron). Set "false" on hosts that sleep when idle
# (e.g. Render free plan) - there, drive POST /api/v1/attendance/close-day
# from an external scheduler instead.
ENABLE_SCHEDULER=true
SCHEDULER_TZ=Asia/Ho_Chi_Minh

# End-of-day attendance close. Keep this in the evening of SCHEDULER_TZ: a run
# between 00:00 and 07:00 local would resolve to the previous UTC date.
# Must stay clear of the overtime window, which now ends at 22:00 (18:00 + the
# 4h daily cap) - a 22:00 run would close records mid-overtime-shift.
CRON_CLOSE_ATTENDANCE=0 23 * * *

# Times used when closing the day. Code falls back to these same values.
WORKDAY_END=18:00
WORKDAY_LATE_AFTER=09:15

# Position Ladder promotion-eligibility check (task 2.4). Keep this well
# clear of CRON_CLOSE_ATTENDANCE so the two never race.
CRON_PROMOTION_ELIGIBILITY=0 2 * * *

# Monthly VND<->USD FX snapshot + auto payroll draft (tasks 3.8/3.9). Runs
# once at the start of the month, ahead of the 10th-of-month official run
# (CRON_MONTHLY_PAYROLL_RUN below). A no-op if a PayrollPeriod for that month
# already exists.
CRON_MONTHLY_PAYROLL_DRAFT=0 1 1 * *

CRON_MONTHLY_PAYROLL_RUN=0 3 10 * *

CRON_ANNUAL_RAISE=0 4 * * *

# FX rate provider for tasks 3.8/3.9. Free tier, no API key required. If the
# fetch fails (network down, provider unreachable, host has restricted
# egress) the job falls back to DEFAULT_FX_RATE_VND_PER_USD in
# utils/payrollEngine.js and tags the snapshot source as "fallback" rather
# than failing the whole draft run.
FX_RATE_API_URL=https://open.er-api.com/v6/latest/USD

# Google AI Studio (Gemini) - performance review "Ask AI" insight (task 5).
# Get a key at https://aistudio.google.com/apikey. Leave unset and the
# endpoint returns a clear 503 instead of crashing.
GEMINI_API_KEY=replace_with_your_gemini_api_key
# gemini-2.5-flash was retired for new API keys as of this writing - Google's
# API itself returns a 404 pointing new keys to gemini-3.6-flash instead.
GEMINI_MODEL=gemini-3.6-flash

# Daily performance-review reminder job (task 5). Fires role-aware
# notifications for reviews due within 7 days of their cycle's deadline.
CRON_PERFORMANCE_REMINDERS=0 9 * * *

# Attendance Overtime demo clock. When "true", an X-App-Now request header
# may override server time so the 13:00 overtime cutoff can be demonstrated
# from both sides without waiting for 13:00 to arrive.
#
# This is a bypass for EVERY date rule in the system, not just the one it was
# added for. It MUST be unset or "false" in production - the server logs a
# startup warning when it is on (utils/appNow.js).
DEMO_MODE=false

# Telegram bot (out-of-app notifications, Level 4b). Leave TELEGRAM_BOT_TOKEN
# unset to disable Telegram entirely - delivery logs once and no-ops, same
# graceful-degrade contract as the Cloudinary and Gemini keys above.
# Create the bot and get a token from https://t.me/BotFather.
TELEGRAM_BOT_TOKEN=
# Without the @. Used to build the t.me deep link shown in Settings.
TELEGRAM_BOT_USERNAME=
# Long random string forming the SECRET WEBHOOK PATH, so only Telegram can
# post updates. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never prefix any of these with VITE_ - they must not reach the frontend.
TELEGRAM_WEBHOOK_SECRET=
# "webhook" in production (Render gives you a public HTTPS URL), "polling"
# for local dev, where localhost has no public URL for Telegram to call.
TELEGRAM_MODE=polling
# Only read when TELEGRAM_MODE=webhook. Registered with Telegram at boot.
# Must end with the same value as TELEGRAM_WEBHOOK_SECRET above:
#   https://<api-host>/api/v1/notifications/telegram/webhook/<secret>
TELEGRAM_WEBHOOK_URL=

# Public URL of the FRONTEND, used to turn a notification's in-app path into
# an absolute "Open in HRMS" button on out-of-app messages. Falls back to
# CORS_ORIGIN; with neither set the message is sent without a button.
APP_BASE_URL=http://localhost:3000

# Outbound email (Level 4a). Leave MAIL_HOST/MAIL_USER unset to disable email
# delivery entirely - sends log once and no-op, same graceful-degrade contract
# as the Cloudinary/Gemini/Telegram keys above.
# Gmail: use an App Password (requires 2FA on the account), NOT the login
# password. Brevo and Resend have free tiers with a plain API key and no 2FA
# dance if Gmail fights you - swapping is a few lines in utils/mailer.js.
MAIL_HOST=smtp.gmail.com
# 465 is implicit TLS, 587 is STARTTLS. utils/mailer.js derives which from this.
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="HRMS <no-reply@hrms.com>"

# Web Push (Level 3, VAPID). Leave the keys unset to disable push entirely -
# sends log once and no-op, same graceful-degrade contract as the keys above.
# Generate a pair with:  npx web-push generate-vapid-keys
#
# !! VAPID_PRIVATE_KEY MUST NEVER GET A VITE_ PREFIX !!
# It is the signing key that proves a push came from this server. Only the
# PUBLIC key belongs in the browser - put the SAME value in the frontend's
# .env.development / .env.production as VITE_VAPID_PUBLIC_KEY. The two are
# easy to confuse: both are opaque base64 strings of similar length.
# (GET /api/v1/notifications/push also serves the public key, so a frontend
# built against the wrong pair can be spotted without redeploying.)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push service can use if this app misbehaves. Required
# by the VAPID spec - Firefox rejects subscriptions without one.
VAPID_SUBJECT=mailto:hr@example.com
